#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 BlackHost.pl

set -Eeuo pipefail

if [[ -z "${BLACKHOST_ROOT:-}" ]]; then
  BLACKHOST_ENTRYPOINT=$(readlink -f "${BASH_SOURCE[0]}")
  BLACKHOST_ROOT=$(cd "$(dirname "$BLACKHOST_ENTRYPOINT")/.." && pwd)
fi

source "${BLACKHOST_ROOT}/lib/ui.sh"
source "${BLACKHOST_ROOT}/lib/core.sh"
source "${BLACKHOST_ROOT}/modules/pterodactyl.sh"
source "${BLACKHOST_ROOT}/modules/blueprint.sh"
source "${BLACKHOST_ROOT}/modules/nginx.sh"
source "${BLACKHOST_ROOT}/modules/speedtest.sh"
source "${BLACKHOST_ROOT}/modules/self_update.sh"
source "${BLACKHOST_ROOT}/modules/phpmyadmin.sh"
source "${BLACKHOST_ROOT}/modules/installer.sh"
source "${BLACKHOST_ROOT}/modules/provision.sh"

show_status() {
  ui_header "STATUS USŁUG"
  ui_section "KOMPONENTY"
  pterodactyl_status
  blueprint_status
  nginx_status
  phpmyadmin_status
}

show_system_summary() {
  local system_name hostname_value uptime_value ip_value
  hostname_value=$(hostname 2>/dev/null || printf 'nieznany')
  if [[ -r /etc/os-release ]]; then
    system_name=$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-$ID}")
  else
    system_name=$(uname -sr)
  fi
  uptime_value=$(uptime -p 2>/dev/null | sed 's/^up //' || printf 'brak danych')
  ip_value=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
  ip_value=${ip_value:-brak}

  printf '\n'
  ui_key_value "HOST" "$hostname_value"
  ui_key_value "SYSTEM" "$system_name"
  ui_key_value "UPTIME" "$uptime_value"
  ui_key_value "IP" "$ip_value"
}

main_menu() {
  local choice
  while :; do
    ui_header "SERVER TOOLKIT"
    show_system_summary
    ui_section "ZARZĄDZANIE"
    ui_option 1 "Instalator" "Pterodactyl, Nginx i kolejne programy"
    ui_option 2 "Stan usług" "Szybka diagnostyka"
    ui_option 3 "Speedtest" "Oficjalny klient Ookla"
    ui_option 4 "Aktualizacja CLI" "Sprawdź i zainstaluj najnowsze wydanie"
    ui_option 0 "Wyjdź" "Powrót do terminala"
    ui_menu_prompt choice

    case "$choice" in
      1) installer_menu ;;
      2) show_status; ui_pause escape ;;
      3) speedtest_run; ui_pause ;;
      4)
        blackhost_self_update || true
        ui_pause
        [[ "${BLACKHOST_UPDATE_APPLIED:-false}" == true ]] && return 0
        ;;
      0) return 0 ;;
      *) ui_error "Nieprawidłowa opcja."; sleep 1 ;;
    esac
  done
}

run_interactive() {
  ui_screen_enter
  trap 'ui_screen_leave' EXIT
  trap 'exit 130' INT TERM HUP
  "$@"
  ui_screen_leave
  trap - EXIT INT TERM HUP
}

show_probe_json() {
  local ptero_panel_inst="false" ptero_panel_ver="" ptero_panel_state="inactive"
  local ptero_wings_inst="false" ptero_wings_ver="" ptero_wings_state="inactive"
  local bp_inst="false" bp_ver="" bp_state="inactive"
  local nginx_inst="false" nginx_ver="" nginx_state="inactive"
  local pma_inst="false" pma_ver="" pma_state="inactive"

  if pterodactyl_panel_installed; then
    ptero_panel_inst="true"
    ptero_panel_ver=$(pterodactyl_panel_version 2>/dev/null || printf '')
    if pterodactyl_panel_healthy; then
      ptero_panel_state="active"
    else
      ptero_panel_state="warning"
    fi
  fi

  if pterodactyl_wings_installed; then
    ptero_wings_inst="true"
    ptero_wings_ver=$(pterodactyl_wings_version 2>/dev/null || printf '')
    if systemctl is-active --quiet wings 2>/dev/null; then
      ptero_wings_state="active"
    else
      ptero_wings_state="warning"
    fi
  fi

  if blueprint_installed; then
    bp_inst="true"
    bp_ver=$(blueprint_version 2>/dev/null || printf '')
    bp_state="active"
  fi

  if nginx_installed; then
    nginx_inst="true"
    nginx_ver=$(nginx_version 2>/dev/null || printf '')
    if systemctl is-active --quiet nginx 2>/dev/null; then
      nginx_state="active"
    else
      nginx_state="warning"
    fi
  fi

  if phpmyadmin_installed; then
    pma_inst="true"
    pma_ver="${PHPMYADMIN_VERSION:-}"
    if systemctl is-active --quiet nginx 2>/dev/null; then
      pma_state="active"
    else
      pma_state="warning"
    fi
  fi

  ptero_panel_ver=$(json_escape "$ptero_panel_ver")
  ptero_wings_ver=$(json_escape "$ptero_wings_ver")
  bp_ver=$(json_escape "$bp_ver")
  nginx_ver=$(json_escape "$nginx_ver")
  pma_ver=$(json_escape "$pma_ver")

  cat <<EOF
{
  "pterodactyl-panel": { "installed": ${ptero_panel_inst}, "version": "${ptero_panel_ver}", "status": "${ptero_panel_state}" },
  "pterodactyl-wings": { "installed": ${ptero_wings_inst}, "version": "${ptero_wings_ver}", "status": "${ptero_wings_state}" },
  "blueprint": { "installed": ${bp_inst}, "version": "${bp_ver}", "status": "${bp_state}" },
  "nginx": { "installed": ${nginx_inst}, "version": "${nginx_ver}", "status": "${nginx_state}" },
  "phpmyadmin": { "installed": ${pma_inst}, "version": "${pma_ver}", "status": "${pma_state}" }
}
EOF
}

case "${1:-menu}" in
  menu) run_interactive main_menu ;;
  installer) run_interactive installer_menu ;;
  status) show_status; printf '\n' ;;
  probe|app-status) show_probe_json ;;
  pterodactyl) run_interactive pterodactyl_menu ;;
  nginx) run_interactive nginx_menu ;;
  phpmyadmin) run_interactive phpmyadmin_menu ;;
  speedtest) speedtest_run; printf '\n' ;;
  update) blackhost_self_update "${2:-}"; printf '\n' ;;
  provision) shift; blackhost_provision_run "$@" ;;
  version|--version|-v) printf 'blackhost %s\n' "$BLACKHOST_VERSION" ;;
  help|--help|-h)
    for help_line in \
      "Użycie: blackhost [menu|installer|status|pterodactyl|nginx|phpmyadmin|speedtest|update|provision|version]" \
      "Bez argumentu uruchamiane jest interaktywne menu." \
      "Użyj blackhost provision --token-file <ścieżka>, aby uruchomić autoinstalację z Dashboardu." \
      "Użyj blackhost update --check, aby tylko sprawdzić dostępność aktualizacji." \
      "Użyj sudo blackhost update --yes, aby zainstalować aktualizację bez pytania." \
      "Ustaw BLACKHOST_ASCII=1, aby wyłączyć znaki Unicode." \
      "Ustaw BLACKHOST_FORCE_CLEAR=1, aby wymusić odrysowywanie ekranu." \
      "Ustaw BLACKHOST_NO_ALT_SCREEN=1, aby wyłączyć osobny ekran terminala."
    do
      ui_safe_text "$help_line"
      printf '%s\n' "$BH_SAFE_TEXT"
    done
    ;;
  *)
    ui_error "Nieznana komenda: $1"
    exit 2
    ;;
esac
